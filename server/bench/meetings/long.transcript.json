    "diagnostics": {},
    "segments": [
      {
        "track": "speaker",
        "start_seconds": 0.5,
        "end_seconds": 22.3,
        "text": "じゃあ時間なので始めましょう。今日は持ち寄りの共有会です",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 22.3,
        "end_seconds": 34.8,
        "text": "はい、お願いします",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 34.8,
        "end_seconds": 57.6,
        "text": "順番は決めてないので、話したい人から行きましょう。まず私から",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 57.6,
        "end_seconds": 78.4,
        "text": "最近、自作のキーボードにはまっていて、その話をします",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 78.4,
        "end_seconds": 105.6,
        "text": "と言っても部品を買って組み立てるだけなんですが、スイッチを選ぶところが沼でして",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 105.6,
        "end_seconds": 123,
        "text": "スイッチってそんなに種類があるんですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 123,
        "end_seconds": 150.2,
        "text": "あります。押したときに音が鳴るタイプ、静かなタイプ、重いもの軽いもの、色々です",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 150.2,
        "end_seconds": 173.5,
        "text": "私は静音の赤軸系を選びました。夜に打っても家族に怒られないので",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 173.5,
        "end_seconds": 185.5,
        "text": "それは大事ですね",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 185.5,
        "end_seconds": 220.5,
        "text": "もう一つ、キーの配列を自分で並べ替えられるのが楽しいです。親指のところに変換キーを置いたら、肩こりが減りました",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 220.5,
        "end_seconds": 236.4,
        "text": "へえ、体の負担まで変わるんですね",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 236.4,
        "end_seconds": 261.2,
        "text": "人によりますけどね。初めてなら、はんだ付け不要のキットがおすすめです",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 261.2,
        "end_seconds": 277.6,
        "text": "はんだごてがなくても作れるんですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 277.6,
        "end_seconds": 304.3,
        "text": "はい、基板にスイッチを差すだけのキットがあります。一時間くらいで終わりました",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 304.3,
        "end_seconds": 317.3,
        "text": "あー、うーん、えっと",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 317.3,
        "end_seconds": 330.3,
        "text": "ここまでで質問あれば",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 330.3,
        "end_seconds": 343.8,
        "text": "値段はどのくらいですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 343.8,
        "end_seconds": 369,
        "text": "キットで一万円台の前半です。キーキャップを凝りだすと上がっていきますが",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 369,
        "end_seconds": 385.9,
        "text": "なるほど、そのくらいなら試せそうです",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 385.9,
        "end_seconds": 400.4,
        "text": "じゃあ次の人、お願いします",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 400.4,
        "end_seconds": 416.3,
        "text": "私は、ベランダの菜園の話をします",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 416.3,
        "end_seconds": 441.5,
        "text": "春にミニトマトとバジルを植えたんですが、最初の失敗が水のやりすぎでした",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 441.5,
        "end_seconds": 454.5,
        "text": "ああ、ありがちですね",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 454.5,
        "end_seconds": 475.8,
        "text": "毎朝たっぷりあげていたら、根が腐って三株ダメにしました",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 475.8,
        "end_seconds": 506.9,
        "text": "それで、土の表面が乾いてから指の第一関節くらいまで確かめてあげる方式に変えたら、持ち直しました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 506.9,
        "end_seconds": 519.9,
        "text": "指で確かめるんですね",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 519.9,
        "end_seconds": 538.8,
        "text": "はい。道具を買うまでもなく、それで十分でした",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 538.8,
        "end_seconds": 563.6,
        "text": "バジルは摘み取るほど脇芽が増えるので、料理にどんどん使うのがコツです",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 563.6,
        "end_seconds": 582,
        "text": "それは嬉しいですね。収穫のたびに増えるなら",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 582,
        "end_seconds": 606.8,
        "text": "ただ、夏の直射日光は葉が焼けるので、午後だけ日よけの布をかけています",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 606.8,
        "end_seconds": 621.7,
        "text": "日よけは何を使ってるんですか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 621.7,
        "end_seconds": 643.5,
        "text": "百円ショップの遮光ネットです。洗濯ばさみで留めるだけです",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 643.5,
        "end_seconds": 657.5,
        "text": "それなら私もできそうです",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 657.5,
        "end_seconds": 689.1,
        "text": "おすすめは、最初はミニトマト一鉢だけにすることです。育てる量を増やすと世話が追いつかなくなります",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 689.1,
        "end_seconds": 708.5,
        "text": "ちょっと画面共有を切り替えますね。見えてますか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 708.5,
        "end_seconds": 719,
        "text": "見えてます",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 719,
        "end_seconds": 742.3,
        "text": "じゃあ次の話題に行きます。家計簿アプリの話を聞いてもらえますか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 742.3,
        "end_seconds": 751.9,
        "text": "どうぞ",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 751.9,
        "end_seconds": 778.6,
        "text": "私は三年くらい、レシートを撮るだけで自動で記録してくれるアプリを使っています",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 778.6,
        "end_seconds": 804.8,
        "text": "手入力だと三日で挫折するタイプなので、撮るだけという仕組みが合っていました",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 804.8,
        "end_seconds": 819.3,
        "text": "読み取りの精度はどうですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 819.3,
        "end_seconds": 845,
        "text": "店名は割と合います。品目は間違うこともあって、月末にまとめて直しています",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 845,
        "end_seconds": 876.1,
        "text": "このアプリの良いところは、月ごとのグラフが自動で出て、食費だけ突出した月が一目で分かることです",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 876.1,
        "end_seconds": 890.6,
        "text": "食費が多い月、ありますよね",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 890.6,
        "end_seconds": 911.9,
        "text": "ありました。外食が続いた月に、グラフを見て反省しました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 911.9,
        "end_seconds": 939.1,
        "text": "ただ、銀行との連携は設定が面倒で、私は途中でやめました。レシートだけで十分です",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 939.1,
        "end_seconds": 955.5,
        "text": "それでも続けられるのが大事ですよね",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 955.5,
        "end_seconds": 982.2,
        "text": "はい。続くかどうかで選ぶのがおすすめです。多機能なものは最初の設定で疲れます",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 982.2,
        "end_seconds": 995.7,
        "text": "無料でも使えるんですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 995.7,
        "end_seconds": 1024.4,
        "text": "基本機能は無料です。私は広告が気になって、年額の有料版に変えました。千円ちょっとです",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1024.4,
        "end_seconds": 1041.3,
        "text": "なるほど、それなら払ってもいいですね",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1041.3,
        "end_seconds": 1062.1,
        "text": "えーと、ちょっとマイクの調子が、すみません、もう一回",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1062.1,
        "end_seconds": 1076.6,
        "text": "聞こえてますよ、大丈夫です",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1076.6,
        "end_seconds": 1091.1,
        "text": "すみません、続けてください",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1091.1,
        "end_seconds": 1122.7,
        "text": "ええと、以上が家計簿アプリです。次の話題は、睡眠についてやりたいんですが、質問形式でもいいですか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1122.7,
        "end_seconds": 1148.9,
        "text": "はい、じゃあ私が質問します。睡眠の質を上げるのに、一番効いたことは何ですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1148.9,
        "end_seconds": 1175.6,
        "text": "寝る前の一時間、スマホを見るのをやめたことです。代わりに紙の本を読んでいます",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1175.6,
        "end_seconds": 1188.6,
        "text": "それだけで違いますか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1188.6,
        "end_seconds": 1220.7,
        "text": "入眠が早くなりました。それまで布団に入ってから三十分くらいかかっていたのが、十分くらいになりました",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1220.7,
        "end_seconds": 1236.1,
        "text": "すごい。続けるコツはありますか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1236.1,
        "end_seconds": 1263.3,
        "text": "スマホを寝室に持ち込まず、居間の充電器に置いています。物理的に離すのが確実です",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1263.3,
        "end_seconds": 1278.2,
        "text": "目覚ましはどうしてるんですか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1278.2,
        "end_seconds": 1301,
        "text": "昔ながらの目覚まし時計を買いました。千五百円くらいのものです",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1301,
        "end_seconds": 1321.8,
        "text": "なるほど。じゃあ次の質問です。休日に寝だめはしますか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1321.8,
        "end_seconds": 1352.9,
        "text": "しないようにしています。起きる時間を平日とずらすと、月曜がつらいので、一時間以内に収めています",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1352.9,
        "end_seconds": 1365.9,
        "text": "それは参考になります",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1365.9,
        "end_seconds": 1392.1,
        "text": "私の睡眠の話も少し。コーヒーを午後二時以降やめたら、夜の目覚めが減りました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1392.1,
        "end_seconds": 1406.1,
        "text": "カフェインは効きますよね",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1406.1,
        "end_seconds": 1430.4,
        "text": "はい。代わりに麦茶にしています。体験として、一週間で効果が出ました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1430.4,
        "end_seconds": 1444.9,
        "text": "一週間なら試しやすいですね",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1444.9,
        "end_seconds": 1466.7,
        "text": "ところで話は変わりますが、この前の連休、どこか行きました",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1466.7,
        "end_seconds": 1487,
        "text": "はい、家族で温泉に行きました。山の方の小さな宿です",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1487,
        "end_seconds": 1501,
        "text": "いいですね。遠いんですか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1501,
        "end_seconds": 1524.3,
        "text": "車で三時間くらいです。途中で渋滞に巻き込まれて、倍かかりました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1524.3,
        "end_seconds": 1539.7,
        "text": "連休の渋滞は避けられないですね",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1539.7,
        "end_seconds": 1560.5,
        "text": "ただ、宿の夕食の鍋が本当においしくて、全部忘れました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1560.5,
        "end_seconds": 1577.9,
        "text": "それは良い旅ですね。何鍋だったんですか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1577.9,
        "end_seconds": 1595.8,
        "text": "地元の鶏と野菜の鍋です。味噌仕立てでした",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1595.8,
        "end_seconds": 1614.7,
        "text": "おいしそう。次の連休はどこに行くか決めてます",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1614.7,
        "end_seconds": 1632.6,
        "text": "まだです。海のほうに行きたいと思っていて",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1632.6,
        "end_seconds": 1652.4,
        "text": "海もいいですね。あ、そうそう、写真は撮りましたか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1652.4,
        "end_seconds": 1672.2,
        "text": "はい、宿の庭の紅葉がきれいで。あとで共有しますね",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1672.2,
        "end_seconds": 1697.9,
        "text": "楽しみにしてます。じゃあ話を戻して、次回以降の共有会の運営を決めたいです",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1697.9,
        "end_seconds": 1710.4,
        "text": "はい、お願いします",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1710.4,
        "end_seconds": 1730.2,
        "text": "論点は二つ。開催の頻度と、発表の担当の決め方です",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1730.2,
        "end_seconds": 1751,
        "text": "まず頻度。今は不定期ですが、毎月にするか隔月にするか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1751,
        "end_seconds": 1772.8,
        "text": "毎月だとネタ切れしそうです。今日も準備に結構かかりました",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1772.8,
        "end_seconds": 1791.7,
        "text": "確かに。隔月だと間が空きすぎて、忘れませんか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1791.7,
        "end_seconds": 1814,
        "text": "カレンダーに先に入れておけば大丈夫です。隔月の第二水曜とか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1814,
        "end_seconds": 1835.3,
        "text": "第二水曜、いいですね。夕方の六時なら参加しやすいですか",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1835.3,
        "end_seconds": 1854.2,
        "text": "はい、その時間なら皆さん都合がつくと思います",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1854.2,
        "end_seconds": 1874,
        "text": "では、共有会は隔月の第二水曜の十八時にしましょう",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1874,
        "end_seconds": 1884,
        "text": "賛成です",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1884,
        "end_seconds": 1901.4,
        "text": "決定です。次に、発表の担当の決め方です",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1901.4,
        "end_seconds": 1916.3,
        "text": "毎回、志願制だと偏りませんか",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1916.3,
        "end_seconds": 1940.6,
        "text": "確かに、話したい人だけになりますね。持ち回りにするのはどうでしょう",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 1940.6,
        "end_seconds": 1970.7,
        "text": "持ち回りだと、話すことがない人が困ります。五分の短い共有でもよいことにすれば負担は軽いです",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 1970.7,
        "end_seconds": 1994.5,
        "text": "それなら、一人五分以上で、持ち回りにしましょう。順番は名簿の順で",
