      },
      {
        "track": "相手",
        "start_seconds": 1994.5,
        "end_seconds": 2008.5,
        "text": "はい、それでお願いします",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 2008.5,
        "end_seconds": 2025.9,
        "text": "では、発表は名簿順の持ち回りで決定です",
        "confidence": 0.9
      },
      {
        "track": "speaker",
        "start_seconds": 2025.9,
        "end_seconds": 2049.7,
        "text": "それに伴う作業です。私が名簿を作って、次の回までに全員に回します",
