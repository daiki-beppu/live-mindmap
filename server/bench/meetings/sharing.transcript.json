      {
        "track": "speaker",
        "start_seconds": 0.5,
        "end_seconds": 16.1,
        "text": "じゃあ始めますね。今日は最近触ったツールの共有会ということで",
        "confidence": 0.9
      },
      {
        "track": "相手",
        "start_seconds": 16.1,
