{
  "name": "@live-mindmap/server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "live-mindmap": "./src/cli.ts"
  },
  "scripts": {
    "dev": "swift build -c release --package-path ../helper && node src/server.ts",
    "cli": "node src/cli.ts",
    "test": "vitest run --project unit",
    "test:it": "vitest run --project it",
    "test:it:heavy": "vitest run --project heavy",
    "test:external": "vitest run --project external",
    "test:it:all": "vitest run --project it --project heavy",
    "deps:install": "node scripts/install-managed-deps.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && effect-tsgo diagnostics --project tsconfig.json && node scripts/check-entrypoints.ts && node scripts/check-ignored-failures.ts && node scripts/check-test-layers.ts && node scripts/check-managed-lock.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "effect": "4.1.2",
    "jose": "^6.2.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.1.2",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
