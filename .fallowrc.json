{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.33.1/schema.json",
  "entry": [
    "server/bench/**/*.ts",
    "e2e/e2e.config.ts",
    "e2e/tests/**/*.e2e.ts",
    "e2e/scripts/serve.ts",
    "server/test/fixtures/fake-helper.ts",
    "server/test/fixtures/chatgptWorker.ts",
    "server/test/fixtures/managedChromiumLaunch.ts",
    "server/test/fixtures/managedDepsProcess.mjs",
    "server/test/fixtures/managedDepsRunnerHooks.mjs"
  ],
  "ignorePatterns": [
    "helper/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@foldkit/oxlint-plugin"
  ],
  "usedClassMembers": [
    "message"
  ],
  "duplicates": {
    "enabled": true,
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "ignoreDefaults": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 0
  },
  "rules": {
    "require-suppression-reason": "error"
  },
  "failOnParseError": true,
  "ignoreExports": [
    {
      "file": "web/src/app/capture/main.ts",
      "exports": [
        "Model",
        "init",
        "update",
        "view"
      ]
    },
    {
      "file": "web/src/app/capture/message.ts",
      "exports": [
        "Message"
      ]
    },
    {
      "file": "web/src/app/keys/message.ts",
      "exports": [
        "Message"
      ]
    },
    {
      "file": "web/src/app/liveFeed/main.ts",
      "exports": [
        "Model",
        "init",
        "update"
      ]
    },
    {
      "file": "web/src/app/liveFeed/message.ts",
      "exports": [
        "Message"
      ]
    },
    {
      "file": "web/src/app/liveFeed/subscription.ts",
      "exports": [
        "subscriptions"
      ]
    },
    {
      "file": "web/src/app/mapSurface/main.ts",
      "exports": [
